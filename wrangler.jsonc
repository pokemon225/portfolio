// Cloudflare Workers config: serves the Vite build in dist/ as static assets.
// Having this file stops `wrangler deploy` from trying to auto-configure Vite.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  // Logs page visits to a Google Sheet (see README "Visitor log")
  "main": "worker/index.js",
  // Keep Worker logs in the dashboard (Logs tab) for troubleshooting
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before serving files, so page visits can be logged
    "run_worker_first": true
  }
}
